{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "lib": ["DOM", "ESNext"],
    "types": ["jest", "react", "react-native"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@app-config": ["./app.json"]
    }
  },
  "include": ["app", "src", "app.json", "**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
