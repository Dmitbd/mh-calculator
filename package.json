{
  "name": "mh-calculator",
  "version": "1.1.0",
  "description": "Mythic Heroes resource calculator",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export:web": "expo export --platform web",
    "export:web:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run export:web",
    "snapshot:hero-builds": "node scripts/export-hero-build-snapshot.cjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "expo:check": "expo install --check",
    "verify": "npm run expo:check && jest --runInBand && npm run typecheck && npm run export:web:clean"
  },
  "keywords": [
    "expo",
    "react-native",
    "mythic-heroes"
  ],
  "author": "Dmitbd",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/jest-preset": "^0.85.3",
    "@supabase/supabase-js": "^2.110.0",
    "expo": "~56.0.19",
    "expo-constants": "~56.0.23",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.18",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "^19.2.14",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "^19.2.0",
    "typescript": "~6.0.3"
  }
}
